(define (domain veritraj-cyberbattle)
 (:requirements :strips :typing)
 (:types node credential service capability - object)
 (:predicates (discovered ?n - node) (owned ?n - node)
  (reachable ?s - node ?t - node) (available ?n - node ?v - capability)
  (remote-available ?n - node ?v - capability)
  (has-credential ?c - credential) (accepts ?n - node ?p - service ?c - credential))
 (:action local :parameters (?n - node ?v - capability)
  :precondition (and (owned ?n) (available ?n ?v))
  :effect (and (owned ?n)))
 (:action remote :parameters (?s - node ?t - node ?v - capability)
  :precondition (and (owned ?s) (discovered ?t) (reachable ?s ?t) (remote-available ?t ?v))
  :effect (and (owned ?t)))
 (:action connect :parameters (?s - node ?t - node ?p - service ?c - credential)
  :precondition (and (owned ?s) (discovered ?t) (reachable ?s ?t) (has-credential ?c) (accepts ?t ?p ?c))
  :effect (and (owned ?t))))
